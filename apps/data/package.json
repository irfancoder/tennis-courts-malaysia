{
  "name": "@tennis/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./venues.json": "./dist/site/venues.json"
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "schema:json": "tsx scripts/json-schema.ts",
    "upload": "tsx scripts/upload-r2.ts",
    "corrections": "tsx scripts/corrections.ts",
    "photos:upload": "tsx scripts/photos-upload.ts",
    "tiles": "bash scripts/tiles-build.sh",
    "dev": "tsx watch --clear-screen=false src/dev.ts"
  },
  "dependencies": {
    "@tennis/schema": "workspace:*",
    "@duckdb/node-api": "1.5.6-r.1",
    "valibot": "1.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tennis/tsconfig": "workspace:*",
    "typescript": "6.0.3",
    "@types/node": "^22",
    "tsx": "4.23.15",
    "vitest": "5.0.3",
    "@valibot/to-json-schema": "1.8.0"
  }
}
