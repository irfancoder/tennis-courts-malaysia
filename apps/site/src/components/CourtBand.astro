---
import * as stylex from "@stylexjs/stylex";
import { s } from "./CourtBand.styles";

interface Props {
  title: string;
  kicker?: string;
  lead?: string;
}
const { title, kicker, lead } = Astro.props;
---
<section {...stylex.props(s.band)}>
  <div {...stylex.props(s.court)}>
    <span {...stylex.props(s.serviceLine)} aria-hidden="true"></span>
    {kicker && <p {...stylex.props(s.kicker)}>{kicker}</p>}
    <h1 {...stylex.props(s.title)}>{title}</h1>
    {lead && <p {...stylex.props(s.lead)}>{lead}</p>}
    {Astro.slots.has("default") && <div {...stylex.props(s.slot)}><slot /></div>}
  </div>
</section>
